{
  "mode": "master",
  "nodeId": "server-a",
  "nodeHeartbeatSeconds": 15,
  "agentOfflineAfterSeconds": 45,
  "discordToken": "replace_with_discord_bot_token_or_use_DISCORD_TOKEN_env",
  "discordGuildId": null,
  "disableDiscord": false,
  "httpPort": 8080,
  "windowsFirewall": {
    "manage": true,
    "trustedNetworks": [
      "LocalSubnet"
    ],
    "reconcileSeconds": 30
  },
  // This physical node keeps its crash-safe pending VM-resume list in this database.
  "databasePath": "C:\\D2ROps\\d2r-host.sqlite",
  "allowedDiscordUserIds": [
    "your_discord_user_id"
  ],
  "startAllDelaySeconds": 20,
  "gameSessionNotificationsEnabled": false,
  "updateNotificationsEnabled": true,
  "guildChannel": null,
  "powerShellPath": "powershell.exe",
  "powerShellTimeoutSeconds": 90,
  "allowedVmNamePrefixes": [
    "d2r-"
  ],
  "settingsDonorAccountKey": null,
  // The authenticated HTTP command API, on the same httpPort as everything else. Master-only, and
  // off until `/d2r config api enabled:true` mints a key. Only the key's hash is ever written here
  // - the key itself is shown once, in Discord, and never stored - so leave keyHash/keyId alone
  // and let the command manage them.
  "api": {
    "enabled": false,
    "keyHash": null,
    "keyId": null,
    "keyCreatedUtc": null
  },
  // Recovery for a VM that freezes partway through a restart, typically on the Windows boot logo.
  // A graceful stop cannot clear that, so the host cuts power outright and starts it again. Only
  // ever runs where the host had already given up and would otherwise restart the whole node.
  // A guest whose Hyper-V heartbeat is answering is never power-cut.
  "vmHangRecovery": {
    "enabled": true,
    "hangSuspectedAfterSeconds": 300,
    "noEvidenceGraceSeconds": 1200,
    "settleSeconds": 10,
    "maxHardPowerCuts": 2
  },
  // The standing sweep for a VM that is powered on while its agent has stopped answering. Hyper-V
  // reports "Running" for a hung guest just as it does for a healthy one, so the verdict comes from
  // the agent's silence, corroborated by the heartbeat. A guest the hypervisor can still reach is
  // restarted in place first; one it cannot reach goes straight to the full power cycle.
  "bootLogoWatchdog": {
    "enabled": true,
    "stuckAfterSeconds": 300,
    "maxHardPowerCuts": 2
  },
  "stuckVmWatchdog": {
    "enabled": true,
    "agentOfflineGraceSeconds": 240,
    "noHeartbeatEvidenceGraceSeconds": 600,
    "minimumVmUptimeSeconds": 180,
    "maxRecoveriesPerVm": 2,
    "sweepIntervalSeconds": 60
  },
  "agents": {
    "d2r-hc-01": {
      "kind": "vm",
      "displayName": "BO-01 VM Agent",
      "sharedSecret": "replace_with_long_random_vm_secret_01",
      "remoteUrl": "parsec://optional-remote-control-link"
    },
    "d2r-hc-02": {
      "kind": "vm",
      "displayName": "BO-02 VM Agent",
      "sharedSecret": "replace_with_long_random_vm_secret_02"
    },
    "server-b": {
      "kind": "host",
      "displayName": "Second Hyper-V Host",
      "sharedSecret": "replace_with_long_random_node_secret_02"
    }
  },
  // Safe host power actions use these exact local vmName values. Only VMs found Running
  // are stopped and restored; VMs already Off remain Off.
  "accounts": {
    "hc1": {
      "agentId": "d2r-hc-01",
      "nodeId": "server-a",
      "vmName": "d2r-hc-01",
      "displayName": "BO-01",
      "characterSlot": 1
    },
    "hc2": {
      "agentId": "d2r-hc-02",
      "nodeId": "server-a",
      "vmName": "d2r-hc-02",
      "displayName": "BO-02",
      "characterSlot": 1
    }
  }
}
